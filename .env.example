# Fully local Cognee routing. Copy to .env; no paid API key is required.
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.1:8b"
LLM_ENDPOINT="http://127.0.0.1:11434/v1"
LLM_API_KEY="ollama"

EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text:latest"
EMBEDDING_ENDPOINT="http://127.0.0.1:11434/api/embed"
EMBEDDING_DIMENSIONS="768"
HUGGINGFACE_TOKENIZER="nomic-ai/nomic-embed-text-v1.5"
EMBEDDING_BATCH_SIZE="5"

# Cognee 1.2.2 requires absolute paths. Replace C:/path/to/explain-fm.
DATA_ROOT_DIRECTORY="C:/path/to/explain-fm/.runtime/cognee/data"
SYSTEM_ROOT_DIRECTORY="C:/path/to/explain-fm/.runtime/cognee/system"
CACHE_ROOT_DIRECTORY="C:/path/to/explain-fm/.runtime/cognee/cache"
COGNEE_LOGS_DIR="C:/path/to/explain-fm/.runtime/cognee/logs"
ENABLE_BACKEND_ACCESS_CONTROL="false"
CACHING="false"
